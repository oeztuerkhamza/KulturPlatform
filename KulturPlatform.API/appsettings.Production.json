{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver,1433;Database=KulturPlatformDb;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://kulturplattformfreiburg.org",
      "https://www.kulturplattformfreiburg.org"
    ]
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "KulturPlatform",
    "Audience": "KulturPlatformApp",
    "ExpirationHours": 24
  },
  "ImageProcessing": {
    "MaxFileSizeBytes": 5242880,
    "DefaultMaxWidth": 1920,
    "DefaultMaxHeight": 1080,
    "DefaultQuality": 85,
    "ThumbnailWidth": 300,
    "ThumbnailHeight": 200
  },
  "FileStorage": {
    "Provider": "Local",
    "BaseUrl": "https://api.kulturplattformfreiburg.org"
  },
  "EmailSettings": {
    "Provider": "Smtp",
    "SmtpHost": "${SMTP_HOST}",
    "SmtpPort": "587",
    "FromEmail": "${SMTP_FROM_EMAIL}",
    "FromName": "Kultur Platform Freiburg",
    "Username": "${SMTP_USERNAME}",
    "Password": "${SMTP_PASSWORD}",
    "RecipientEmail": "info@kulturplattformfreiburg.org",
    "EnableSsl": "true",
    "MaxEmailsPerHour": "100",
    "RateLimitWindowMinutes": "60"
  },
  "AppSettings": {
    "BaseUrl": "https://kulturplattformfreiburg.org"
  }
}
