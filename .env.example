# KulturPlatform - Production Environment Variables
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=kulturplattformfreiburg.org

# ── SQL Server ────────────────────────────────────────────────────────────────
# En az 8 karakter, büyük/küçük harf + rakam + özel karakter içermeli
MSSQL_SA_PASSWORD=YourStrongPassword@2026!

# ── JWT ───────────────────────────────────────────────────────────────────────
# En az 32 karakter rastgele string (openssl rand -base64 32 ile üretin)
JWT_SECRET_KEY=CHANGE_ME_use_openssl_rand_base64_32

# ── E-Posta (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_FROM_EMAIL=noreply@kulturplattformfreiburg.org
SMTP_USERNAME=noreply@kulturplattformfreiburg.org
SMTP_PASSWORD=YourEmailPassword
SMTP_ENABLE_SSL=true
